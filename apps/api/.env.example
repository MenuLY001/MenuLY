# Supabase project URL (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# service_role secret key — NEVER expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port for the Express API server
PORT=3001

# Frontend origin(s) for CORS — comma-separated for multiple domains
FRONTEND_URL=http://localhost:5173

# ─── Razorpay (test mode) ────────────────────────────────────────────────────
# Find these in Razorpay Dashboard → Settings → API Keys
# Use rzp_test_* keys for test mode, rzp_live_* for production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Webhook secret — set in Razorpay Dashboard → Webhooks → Secret
# Used to verify every incoming webhook request signature.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Supabase project URL (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# service_role secret key — NEVER expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port for the Express API server
PORT=3001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# ─── Platform Registration Key ──────────────────────────────────────────────────
# Secret URL segment for the platform owner registration endpoint.
# This becomes: POST /api/platform/<KEY>/register
#               POST /api/platform/<KEY>/login
#
# MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEVER share this key. NEVER commit the real value to source control.
# If missing or < 32 chars, the registration routes are DISABLED entirely.
PLATFORM_REGISTRATION_KEY=537858c1b3e5c729f61413859680d576a432772fccfd337c21f828537f6c3a78
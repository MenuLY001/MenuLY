{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "menu-ly.vercel.app" }],
      "destination": "https://www.menuly.shop/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://menuly-production-5038.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
